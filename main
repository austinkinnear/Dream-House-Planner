        </div>

        <div style="margin-top: 20px; padding-top: 10px; border-top: 1px solid #e5e7eb; padding-bottom: 40px;">
             <button class="btn" onclick="clearCanvas()" style="width: 100%;">Clear Canvas</button>
        </div>
    </div>

    <div id="viewport">
        <div id="toolbar">
            <button class="btn" onclick="adjustZoom(-0.1)">➖</button>
            <button class="btn" onclick="resetZoom()">Reset</button>
            <button class="btn" onclick="adjustZoom(0.1)">➕</button>
            <div style="width:1px; height:20px; background:#e5e7eb; margin:0 5px;"></div>
            <button class="btn" id="blueprint-btn" onclick="toggleBlueprint()">👁️ Blueprint View</button>
        </div>
        
        <div id="stats-panel">
            <h3>📐 Area Summary</h3>
            <div class="stat-row">
                <span>🏠 Living Space:</span>
                <span id="sqft-living">0 sq ft</span>
            </div>
            <div class="stat-row">
                <span>🏗️ Structures:</span>
                <span id="sqft-service">0 sq ft</span>
            </div>
            <div class="stat-row">
                <span>🌳 Grounds:</span>
                <span id="sqft-grounds">0 sq ft</span>
            </div>
            <div class="stat-row stat-total">
                <span>Total Footprint:</span>
                <span id="sqft-total">0 sq ft</span>
            </div>
        </div>

        <div id="world">
            <!-- Rooms will be dropped here -->
        </div>
    </div>

    <div id="controls">
        <button class="btn" onclick="rotateSelected()">🔄 Rotate</button>
        <button class="btn danger" onclick="deleteSelected()">🗑️ Delete</button>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // --- Firebase Config & Init ---
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

        // Fix: Define scope variables for module
        const world = document.getElementById('world');
        const PIXELS_PER_FOOT = 10;

        let currentUser = null;

        // --- Auth Logic ---
        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.error("Auth error:", err);
            }
        };

        initAuth();

        onAuthStateChanged(auth, async (user) => {
            currentUser = user;
            if (user) {
                console.log("User signed in:", user.uid);
                // Attempt to load existing save, OR load reconstruction if empty
                await loadLayout();
            }
        });

        window.saveLayout = async function() {
            if (!currentUser) {
                alert("Please wait for authentication to finish.");
                return;
            }

            const statusEl = document.getElementById('save-status');
            statusEl.innerText = "Saving...";
            statusEl.style.opacity = 1;

            const rooms = [];
            document.querySelectorAll('.room').forEach(el => {
                const w = parseInt(el.dataset.w);
                const h = parseInt(el.dataset.h);
                // Calculate world coords from style
                const leftPx = parseInt(el.style.left);
                const topPx = parseInt(el.style.top);
                // Convert to approximate world feet for saving (assuming 10px = 1ft)
                const x = leftPx / 10;
                const y = topPx / 10;

                rooms.push({
                    name: el.dataset.name,
                    type: el.dataset.type,
                    style: Array.from(el.classList).find(c => c !== 'room' && c !== 'selected') || 'default',
                    width: w,
                    height: h,
                    x: x,
                    y: y
                });
            });

            try {
                const userDocRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'data', 'layout');
                await setDoc(userDocRef, { rooms: rooms, updatedAt: new Date() });
                
                statusEl.innerText = "Project Saved!";
                setTimeout(() => { statusEl.style.opacity = 0; }, 2000);
            } catch (e) {
                console.error("Error saving:", e);
                statusEl.innerText = "Error Saving!";
            }
        };

        async function loadLayout() {
            if (!currentUser) return;
            
            try {
                const userDocRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'data', 'layout');
                const docSnap = await getDoc(userDocRef);

                if (docSnap.exists()) {
                    const data = docSnap.data();
                    if (data.rooms && data.rooms.length > 0) {
                        console.log("Loading saved layout...");
                        clearWorld();
                        data.rooms.forEach(r => {
                            // Convert feet back to pixels for createRoom logic
                            createRoomWorld(r.x, r.y, r); 
                        });
                        return;
                    }
                }
            } catch (e) {
                console.log("No remote save found or error loading, using reconstruction.");
            }

            // Fallback: Default to empty canvas for new users
            console.log("Starting with empty canvas");
            // DO NOT load reconstruction automatically
        }
        
        // --- Expose functions to window for onclick handlers ---
        // (Previously defined functions need to be exposed because we are in a module)
        
        window.createRoomWorld = function(feetX, feetY, data) {
             const room = document.createElement('div');
            room.classList.add('room');
            if (data.style && data.style !== 'default') room.classList.add(data.style);
            
            // Set dimensions
            const wPx = data.width * PIXELS_PER_FOOT;
            const hPx = data.height * PIXELS_PER_FOOT;
            room.style.width = wPx + 'px';
            room.style.height = hPx + 'px';

            // Position
            const leftPx = feetX * PIXELS_PER_FOOT;
            const topPx = feetY * PIXELS_PER_FOOT;

            room.style.left = leftPx + 'px';
            room.style.top = topPx + 'px';

            // Store data
            room.dataset.w = data.width;
            room.dataset.h = data.height;
            room.dataset.type = data.type;
            room.dataset.name = data.name;
            room.dataset.style = data.style || 'default';

            // Content
            if(data.type === 'fence') {
                room.innerHTML = `<div>${data.name}</div>`;
            } else {
                room.innerHTML = `<div>${data.name}</div><div style="font-size:0.7em; margin-top:2px;">${data.width}' x ${data.height}'</div>`;
            }

            // Events
            room.addEventListener('mousedown', (e) => {
                if (e.button !== 0) return;
                e.stopPropagation(); 
                if(window.startDragRoom) window.startDragRoom(e, room);
            });

            room.addEventListener('click', (e) => {
                e.stopPropagation();
                if(window.selectRoom) window.selectRoom(room);
            });

            world.appendChild(room);
            window.updateStats(); // Update stats on create
        }

        window.clearWorld = function() {
            if(world) world.innerHTML = '';
            window.updateStats();
        }

    </script>

    <script>
        // --- Standard Logic (UI, Dragging, Panning) ---
        // Keeping this separate from module scope to ensure global access where needed, 
        // though typically module scope is cleaner. Merging minimal logic here.

        const PIXELS_PER_FOOT = 10; 
        const GRID_SIZE = 20;
        let selectedRoom = null;
        let draggedTemplateData = null;

        // Viewport State
        let scale = 0.6; // Matches resetZoom
        let panX = 0;
        let panY = 0;
        let isPanning = false;
        let panStartX, panStartY;

        // Drag State
        let isDraggingRoom = false;
        let dragStartX, dragStartY;
        let roomStartLeft, roomStartTop;

        const viewport = document.getElementById('viewport');
        const world = document.getElementById('world');
        const controls = document.getElementById('controls');

        // Initial Center (approx center of 8000px world)
        panX = (viewport.getBoundingClientRect().width / 2) - (4000 * scale);
        panY = (viewport.getBoundingClientRect().height / 2) - (4000 * scale);
        world.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;

        // --- Sidebar Drag Events ---
        document.querySelectorAll('.room-template').forEach(template => {
            template.addEventListener('dragstart', (e) => {
                draggedTemplateData = {
                    type: template.dataset.type,
                    name: template.querySelector('.name').innerText,
                    width: parseInt(template.dataset.w),
                    height: parseInt(template.dataset.h),
                    style: template.dataset.color || 'default'
                };
            });
        });

        // --- Viewport Drop Events ---
        viewport.addEventListener('dragover', (e) => e.preventDefault());
        
        viewport.addEventListener('drop', (e) => {
            e.preventDefault();
            if (draggedTemplateData) {
                const rect = viewport.getBoundingClientRect();
                // Screen to World Conversion
                const worldXPx = (e.clientX - rect.left - panX) / scale;
                const worldYPx = (e.clientY - rect.top - panY) / scale;
                
                // Convert to Feet for createRoomWorld
                const worldXFt = worldXPx / PIXELS_PER_FOOT;
                const worldYFt = worldYPx / PIXELS_PER_FOOT;

                // Snap logic is inside createRoomWorld visually, but let's align data
                // We'll just call the creation function which handles style
                // Note: We need to access the function defined in module
                if(window.createRoomWorld) {
                    // Pre-snap calculation for visual consistency
                     const snapX = Math.round(worldXFt * PIXELS_PER_FOOT / GRID_SIZE) * GRID_SIZE / PIXELS_PER_FOOT;
                     const snapY = Math.round(worldYFt * PIXELS_PER_FOOT / GRID_SIZE) * GRID_SIZE / PIXELS_PER_FOOT;
                    window.createRoomWorld(snapX, snapY, draggedTemplateData);
                }
                draggedTemplateData = null;
            }
        });

        // --- Mouse Interaction ---
        viewport.addEventListener('mousedown', (e) => {
            if (e.target.closest('.room')) return;
            deselectAll();
            isPanning = true;
            panStartX = e.clientX - panX;
            panStartY = e.clientY - panY;
            viewport.style.cursor = 'grabbing';
        });

        window.addEventListener('mousemove', (e) => {
            if (isPanning) {
                panX = e.clientX - panStartX;
                panY = e.clientY - panStartY;
                updateTransform();
            } else if (isDraggingRoom && selectedRoom) {
                const dx = (e.clientX - dragStartX) / scale;
                const dy = (e.clientY - dragStartY) / scale;

                let newLeft = roomStartLeft + dx;
                let newTop = roomStartTop + dy;

                newLeft = Math.round(newLeft / GRID_SIZE) * GRID_SIZE;
                newTop = Math.round(newTop / GRID_SIZE) * GRID_SIZE;

                selectedRoom.style.left = newLeft + 'px';
                selectedRoom.style.top = newTop + 'px';
            }
        });

        window.addEventListener('mouseup', () => {
            isPanning = false;
            isDraggingRoom = false;
            viewport.style.cursor = 'grab';
        });

        viewport.addEventListener('wheel', (e) => {
            if(e.ctrlKey || e.metaKey || e.shiftKey) {
                e.preventDefault();
                const delta = e.deltaY > 0 ? -0.05 : 0.05;
                window.adjustZoom(delta);
            }
        });

        window.adjustZoom = function(delta) {
            const oldScale = scale;
            scale = Math.max(0.1, Math.min(3, scale + delta));
            const rect = viewport.getBoundingClientRect();
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            panX = centerX - (centerX - panX) * (scale / oldScale);
            panY = centerY - (centerY - panY) * (scale / oldScale);
            updateTransform();
        }

        window.resetZoom = function() {
            scale = 0.6;
            const rect = viewport.getBoundingClientRect();
            panX = (rect.width / 2) - (4000 * scale);
            panY = (rect.height / 2) - (4000 * scale);
            updateTransform();
        }

        function updateTransform() {
            world.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
        }

        window.toggleBlueprint = function() {
            document.body.classList.toggle('blueprint-mode');
            const btn = document.getElementById('blueprint-btn');
            if(document.body.classList.contains('blueprint-mode')) {
                btn.innerText = '🎨 Standard View';
                btn.classList.add('primary');
            } else {
                btn.innerText = '👁️ Blueprint View';
                btn.classList.remove('primary');
            }
        }

        // --- Room Helpers ---
        window.startDragRoom = function(e, room) {
            isDraggingRoom = true;
            window.selectRoom(room);
            dragStartX = e.clientX;
            dragStartY = e.clientY;
            roomStartLeft = parseInt(room.style.left || 0);
            roomStartTop = parseInt(room.style.top || 0);
        }

        window.selectRoom = function(room) {
            window.deselectAll();
            selectedRoom = room;
            room.classList.add('selected');
            controls.style.display = 'flex';
        }

        window.deselectAll = function() {
            document.querySelectorAll('.room').forEach(r => r.classList.remove('selected'));
            selectedRoom = null;
            controls.style.display = 'none';
        }

        window.rotateSelected = function() {
            if (!selectedRoom) return;
            let w = parseInt(selectedRoom.dataset.w);
            let h = parseInt(selectedRoom.dataset.h);
            
            // Swap
            let newW = h;
            let newH = w;
            selectedRoom.dataset.w = newW;
            selectedRoom.dataset.h = newH;
            
            selectedRoom.style.width = (newW * PIXELS_PER_FOOT) + 'px';
            selectedRoom.style.height = (newH * PIXELS_PER_FOOT) + 'px';
            
            const name = selectedRoom.querySelector('div').innerText;
            // Update inner html based on type (simpler for fence)
            if(selectedRoom.dataset.type === 'fence') {
                 selectedRoom.innerHTML = `<div>${name}</div>`;
            } else {
                 selectedRoom.innerHTML = `<div>${name}</div><div style="font-size:0.7em; margin-top:2px;">${newW}' x ${newH}'</div>`;
            }
            window.updateStats();
        }

        window.deleteSelected = function() {
            if (selectedRoom) {
                selectedRoom.remove();
                window.deselectAll();
                window.updateStats();
            }
        }
        
        window.clearCanvas = function() {
            if(confirm("Clear all rooms?")) {
                world.innerHTML = '';
                window.deselectAll();
                window.updateStats();
            }
        }

        // --- Stats Logic (Refined) ---
        window.updateStats = function() {
            let living = 0;
            let structures = 0;
            let grounds = 0;

            document.querySelectorAll('.room').forEach(room => {
                const w = parseInt(room.dataset.w);
                const h = parseInt(room.dataset.h);
                const area = w * h;
                const type = room.dataset.type;
                const style = room.dataset.style; 

                // Refined Logic
                // 1. Structures: Unconditioned or detached buildings
                if (['garage', 'garage3', 'stable', 'barn', 'workshop', 'greenhouse', 'shed', 'gate', 'basketball', 'pickleball', 'bowling', 'batting', 'coop', 'rabbit'].includes(type)) {
                    structures += area;
                }
                // 2. Grounds: Outdoor hardscape/landscape
                else if (['outdoor', 'landscape'].includes(style) || ['driveway', 'rvpad', 'fence', 'cistern', 'hives'].includes(type)) {
                    grounds += area;
                }
                // 3. Living: Everything else (Conditioned Interior)
                else {
                    living += area;
                }
            });

            document.getElementById('sqft-living').innerText = living.toLocaleString() + ' sq ft';
            document.getElementById('sqft-service').innerText = structures.toLocaleString() + ' sq ft'; // Maps to "Structures" label
            document.getElementById('sqft-grounds').innerText = grounds.toLocaleString() + ' sq ft';
            document.getElementById('sqft-total').innerText = (living + structures + grounds).toLocaleString() + ' sq ft'; 
        }

        // --- Export Logic (New) ---
        window.exportForSketchup = function() {
            const rooms = document.querySelectorAll('.room');
            if (rooms.length === 0) {
                alert("Place some rooms first!");
                return;
            }

            // 1. Calculate bounding box of all rooms relative to #world
            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;

            rooms.forEach(room => {
                const left = parseInt(room.style.left || 0);
                const top = parseInt(room.style.top || 0);
                const w = parseInt(room.style.width || 0);
                const h = parseInt(room.style.height || 0);
                
                if (left < minX) minX = left;
                if (top < minY) minY = top;
                if (left + w > maxX) maxX = left + w;
                if (top + h > maxY) maxY = top + h;
            });

            // Add padding (e.g. 50px)
            const padding = 50;
            const captureWidth = (maxX - minX) + (padding * 2);
            const captureHeight = (maxY - minY) + (padding * 2);

            // 2. Create a temporary container off-screen
            const tempContainer = document.createElement('div');
            tempContainer.style.position = 'absolute';
            tempContainer.style.top = '0';
            tempContainer.style.left = '-9999px';
            tempContainer.style.width = captureWidth + 'px';
            tempContainer.style.height = captureHeight + 'px';
            tempContainer.style.backgroundColor = 'white';
            // Grid lines
            tempContainer.style.backgroundImage = 'linear-gradient(#e1e4e8 1px, transparent 1px), linear-gradient(90deg, #e1e4e8 1px, transparent 1px)';
            tempContainer.style.backgroundSize = '20px 20px';
            
            // 3. Clone rooms into temp container
            rooms.forEach(room => {
                const clone = room.cloneNode(true);
                // Adjust position to be relative to the new container's 0,0 (plus padding)
                const originalLeft = parseInt(room.style.left || 0);
                const originalTop = parseInt(room.style.top || 0);
                
                clone.style.left = (originalLeft - minX + padding) + 'px';
                clone.style.top = (originalTop - minY + padding) + 'px';
                clone.classList.remove('selected'); // ensure no selection border
                tempContainer.appendChild(clone);
            });

            document.body.appendChild(tempContainer);

            // 4. Capture with html2canvas
            html2canvas(tempContainer).then(canvas => {
                const link = document.createElement('a');
                link.download = 'dream-house-layout.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
                document.body.removeChild(tempContainer);
            }).catch(err => {
                console.error("Export failed:", err);
                alert("Export failed. Please try again.");
                document.body.removeChild(tempContainer);
            });
        }

    </script>
</body>
</html>
