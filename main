        </div>
        <div class="room-template" draggable="true" data-type="flag" data-w="4" data-h="4" data-color="landscape">
            <span class="name">🚩 Flag Pole</span>
            <span class="dims">4' x 4'</span>
        </div>
        <div class="room-template" draggable="true" data-type="dogrun" data-w="10" data-h="20" data-color="landscape">
